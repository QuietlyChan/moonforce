///|
test "golden: xy_6 (300 tick, 每 50 tick 快照)" {
  let sim = @simulation.Simulation::new(6)
  sim.nodes.xs[0] = 5
  sim.nodes.ys[0] = 4
  sim.nodes.xs[1] = 12
  sim.nodes.ys[1] = -11
  sim.nodes.xs[2] = -8
  sim.nodes.ys[2] = 7
  sim.nodes.xs[3] = 3
  sim.nodes.ys[3] = -2
  sim.nodes.xs[4] = -15
  sim.nodes.ys[4] = 13
  sim.nodes.xs[5] = 9
  sim.nodes.ys[5] = -9
  ignore(sim.add_force(@forces.Force::PosX(@forces.XForce::new(6, 0.0, 0.1))))
  ignore(sim.add_force(@forces.Force::PosY(@forces.YForce::new(6, 0.0, 0.1))))
  ignore(sim.tick(50))
  assert_true((sim.nodes.xs[0] - 0.01416624385792647).abs() < 1.0e-9)
  assert_true((sim.nodes.ys[0] - 0.011332995086341183).abs() < 1.0e-9)
  assert_true((sim.nodes.xs[1] - 0.03399898525902354).abs() < 1.0e-9)
