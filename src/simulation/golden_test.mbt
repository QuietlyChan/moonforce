test "golden: radial_8 (300 tick, 每 50 tick 快照)" {
  let sim = @simulation.Simulation::new(8)
  sim.nodes.xs[0] = 10
  sim.nodes.ys[0] = 0
  sim.nodes.xs[1] = -10
  sim.nodes.ys[1] = 0
  sim.nodes.xs[2] = 0
  sim.nodes.ys[2] = 10
  sim.nodes.xs[3] = 5
  sim.nodes.ys[3] = -5
  sim.nodes.xs[4] = -5
  sim.nodes.ys[4] = 5
  sim.nodes.xs[5] = 20
  sim.nodes.ys[5] = 20
  sim.nodes.xs[6] = -20
  sim.nodes.ys[6] = -20
  sim.nodes.xs[7] = 0
  sim.nodes.ys[7] = -10
  ignore(
    sim.add_force(
      @forces.Force::Radial(@forces.RadialForce::new(8, 0.0, 0.0, 50.0, 0.1)),
    ),
  )
  ignore(sim.tick(50))
  assert_true((sim.nodes.xs[0] - 49.88667004913657).abs() < 1.0e-9)
